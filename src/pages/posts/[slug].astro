---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    return data.draft !== true;
  });

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, date } = post.data;
---

<BaseLayout
  title={`${title.en} — Dev`}
  description={description.en}
>
  <article class="post">
    <!-- Header -->
    <header class="post-header">
      <a href="/posts/" class="back">← Back to posts</a>

      <h1>{title.en}</h1>

      <p class="desc">{description.en}</p>
      <p class="desc mm">{description.mm}</p>

      <time class="date">
        {date.toLocaleDateString("en-GB", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    </header>

    <!-- Content -->
    <div class="content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* ---------- ARTICLE ---------- */
  .post {
    max-width: 70ch;
    margin: 0 auto;
  }

  /* ---------- HEADER ---------- */
  .post-header {
    margin-bottom: 4rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
    transition: color 120ms ease;
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 65ch;
  }

  .desc.mm {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .date {
    display: block;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  /* ---------- CONTENT ---------- */
  .content :global(*) {
    line-height: 1.75;
  }

  .content :global(p) {
    margin: 1.3rem 0;
  }

  .content :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1rem;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  .content :global(h3) {
    margin-top: 3rem;
    margin-bottom: 0.8rem;
    font-size: 1.2rem;
  }

  .content :global(ul) {
    padding-left: 1.4rem;
    margin: 1.2rem 0;
  }

  .content :global(li) {
    margin: 0.5rem 0;
  }

  .content :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: rgba(0, 0, 0, 0.04);
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }

  .content :global(pre) {
    background: rgba(0, 0, 0, 0.04);
    padding: 1.2rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 2rem 0;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
  }

  /* ---------- ACCESSIBILITY ---------- */
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
