---
import Navbar from "../components/Navbar.astro";

const { title = "Dev", description = "" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #ffffff;
    --text-main: #0f172a;
    --text-muted: #475569;
    --border: #e5e7eb;
    --accent: #2563eb;
  }

  body {
    margin: 0;
    background: var(--bg);
  }

  main {
    max-width: 68ch;
    margin: 0 auto;
    padding: clamp(6rem, 12vh, 8rem) 1.5rem 5rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.7;
    color: var(--text-main);
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 3.6rem);
    letter-spacing: -0.035em;
    font-weight: 800;
    margin-bottom: 1.2rem;
  }

  h2 {
    margin-top: 4rem;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
